<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Claude-AI: old sample suite, kept for reference. To run it: right-click this file in IntelliJ and choose Run -->
<suite name="Automation Exercise Test Suite" verbose="1"
       parallel="methods" thread-count="1">

    <listeners>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>

    <test name="Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="reference.automationexercise.testcases.ProductReviewTest">
                <methods>
                    <include name="TC01"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
