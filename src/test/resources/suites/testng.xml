<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Claude-AI: main suite - runs every test class under testarchitecttraining -->
<suite name="TestArchitect Training Test Suite" verbose="1"
       parallel="methods" thread-count="1">

    <listeners>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>

    <test name="Test">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="testarchitecttraining"/>
        </packages>
    </test>
</suite>
